+/**
+ * Committed work the backlog clock cannot see yet. The clock counts only what pacing has admitted, but a decision
+ * describes a capture shot [shutterLagMs] ago, and every shot taken since is already committed to this pipeline.
+ * Divide that lag by the burst's shutter cadence and the count falls out.
+ *
+ * The two subtractions are what keep this at zero on a burst the pipeline is keeping up with, rather than taxing it:
+ * [PACING_WINDOW_DRAFT_COUNT] of those captures are the reserves the deficit already prices, and
+ * [queuedDraftCount] more are already inside [backlogMs]. Only the remainder is unpriced.
+ *
+ * It is the feedforward half of the pair: the growth trend has to watch the queue rise before it can report one, and
+ * a burst that outruns the pipeline is over before it has watched enough. This needs two deadlines, which arrive
+ * before the burst's first Draft has finished.
+ *
+ * The count is capped by the arrivals [timeToDeadlineMs] still has room for, which is what keeps a stalled deadline
+ * stream from reading as an enormous burst: the lag grows without bound once commits stop arriving, and the window it
+ * is charged against is the same window that is closing. On a burst still filling, the lag is far shorter than the
+ * window and the cap is inert.
+ */
+private fun estimateUnseenCaptureWorkMs(
+    queuedDraftCount: Int,
+    shutterIntervalMs: Double,
+    shutterLagMs: Double,
+    timeToDeadlineMs: Long,
+    draftSequenceReservedDurationMs: Double,
+): Double {
+    if (shutterIntervalMs <= 0.0) {
+        return 0.0
+    }
+    val remainingWindowCaptureCount = timeToDeadlineMs.coerceAtLeast(0L) / shutterIntervalMs
+    val inFlightCaptureCount = (shutterLagMs / shutterIntervalMs).coerceAtMost(remainingWindowCaptureCount)
+    val unseenCaptureCount = inFlightCaptureCount - PACING_WINDOW_DRAFT_COUNT - queuedDraftCount
+    return (unseenCaptureCount * draftSequenceReservedDurationMs).coerceAtLeast(0.0)
+}
