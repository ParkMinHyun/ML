+package com.samsung.android.camera.core2.ml
+
+import java.util.function.DoubleSupplier
+import kotlin.math.roundToLong
+
+/**
+ * RQ3 Thermal-LUT baseline.
+ *
+ * The only runtime input is continuous thermal headroom.  Delay is linearly interpolated between calibrated control
+ * points, avoiding a discontinuous jump at a thermal bucket boundary.  This class deliberately has no queue,
+ * workload-prediction, or online-duration input.
+ */
+class ThermalLutCaptureAvailableDelayPolicy(
+    private val config: Config,
+    private val thermalHeadroomSupplier: DoubleSupplier,
+) : CaptureAvailableDelayPolicy {
+
+    override fun decide(input: CaptureAvailableDelayPolicyInput): CaptureAvailableDelayPolicyDecision {
+        val delayMs = config.delayMs(thermalHeadroomSupplier.getAsDouble())
+        return CaptureAvailableDelayPolicyDecision(
+            delayMs = delayMs,
+            levelDeficitMs = delayMs,
+            backlogDeficitMs = 0L,
+            backlogMs = 0L,
+        )
+    }
+
+    data class Config(
+        val delayMsByThermalHeadroom: Map<Double, Long>,
+        val fallbackDelayMs: Long,
+    ) {
+        private val controlPoints = delayMsByThermalHeadroom.entries.sortedBy { it.key }
+
+        init {
+            require(delayMsByThermalHeadroom.isNotEmpty())
+            require(delayMsByThermalHeadroom.keys.all { headroom -> headroom.isFinite() })
+            require(delayMsByThermalHeadroom.values.all { delayMs -> delayMs >= 0L })
+            require(fallbackDelayMs >= 0L)
+        }
+
+        fun delayMs(thermalHeadroom: Double): Long {
+            if (!thermalHeadroom.isFinite() || thermalHeadroom < 0.0) {
+                return fallbackDelayMs
+            }
+
+            val upperIndex = controlPoints.indexOfFirst { point -> point.key >= thermalHeadroom }
+            if (upperIndex < 0) {
+                return controlPoints.last().value
+            }
+            if (upperIndex == 0) {
+                return controlPoints.first().value
+            }
+
+            val lower = controlPoints[upperIndex - 1]
+            val upper = controlPoints[upperIndex]
+            val ratio = (thermalHeadroom - lower.key) / (upper.key - lower.key)
+            return (lower.value.toDouble() + (upper.value - lower.value).toDouble() * ratio)
+                .roundToLong()
+                .coerceAtLeast(0L)
+        }
+    }
+}
