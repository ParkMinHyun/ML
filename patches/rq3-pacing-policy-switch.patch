new file mode 100644
index 0000000..42fe714
--- /dev/null
+++ b/CaptureAvailableDelayPolicy.kt
@@ -0,0 +1,105 @@
+package com.samsung.android.camera.core2.ml
+
+/**
+ * The delay arithmetic [CaptureAvailablePacer] runs at each captureAvailable callback, made swappable so a pacing
+ * policy can be exchanged without exchanging anything else.
+ *
+ * Everything that is not the delay decision stays with the pacer: admission pairing, workload prediction, session
+ * boundaries, the backlog clock it reports, and the persisted decision record. A policy therefore cannot give itself
+ * a different admission path, a different callback, or a different metrics definition than the policy it is compared
+ * against - it sees one immutable snapshot per callback and answers with a delay.
+ *
+ * Not synchronized: [CaptureAvailablePacer] calls every method under its own lock.
+ */
+interface CaptureAvailableDelayPolicy {
+
+    fun decide(input: CaptureAvailableDelayPolicyInput): CaptureAvailableDelayPolicyDecision
+
+    /**
+     * A draft entered the single-worker pipeline, consuming [gatingDecision] - the admission this draft start was
+     * paired with, absent when nothing gated it. [queuedDraftCount] is the depth left behind it.
+     */
+    fun onDraftStarted(
+        startUptimeMs: Long,
+        gatingDecision: CaptureAvailablePacingDecision?,
+        queuedDraftCount: Int,
+    ) = Unit
+
+    /** A draft left the single-worker pipeline with a measured wall time. */
+    fun onDraftMeasured(sizeBucket: SizeBucket, draftSequenceDurationMs: Long) = Unit
+
+    /** The burst session ended. Pipeline-lifetime calibration may deliberately survive this. */
+    fun clearSession() = Unit
+}
+
+/**
+ * Runtime facts available at one captureAvailable decision.
+ *
+ * [backlogMs] is the pacer's own admitted-work clock. It is passed to every policy and reported on every decision so
+ * that it stays one comparable observation across policies, but only a policy that chooses to price against it reads
+ * it - a queue-observation policy is free to maintain its own estimate instead.
+ */
+data class CaptureAvailableDelayPolicyInput(
+    val decisionUptimeMs: Long,
+    val draftSequenceBudgetMs: Long,
+    val draftSequenceReservedDurationMs: Double,
+    val backlogMs: Long,
+    val queuedDraftCount: Int,
+    val timeToDeadlineMs: Long,
+)
+
+/**
+ * One policy's answer. [delayMs] is what the callback actually waits.
+ *
+ * The two deficit fields exist because the persisted metrics and the APM log already carry them; a policy that does
+ * not decompose its delay that way reports the components it does have and leaves the rest at zero. They are
+ * diagnostics, never re-combined into the applied delay.
+ */
+data class CaptureAvailableDelayPolicyDecision @JvmOverloads constructor(
+    val delayMs: Long,
+    val levelDeficitMs: Long = 0L,
+    val backlogDeficitMs: Long = 0L,
+) {
+    init {
+        require(delayMs >= 0L) { "delayMs must be non-negative but was $delayMs" }
+        require(levelDeficitMs >= 0L) { "levelDeficitMs must be non-negative but was $levelDeficitMs" }
+        require(backlogDeficitMs >= 0L) { "backlogDeficitMs must be non-negative but was $backlogDeficitMs" }
+    }
+}
+
+/**
+ * Never delays. The parallel-capture pipeline runs exactly as it does with no pacer at all, but through the same
+ * admission path, the same predictor, and the same metrics writer as every other policy - so an unpaced arm is a
+ * one-constant change rather than a separately built binary whose differences have to be argued away.
+ */
+object NoPacingDelayPolicy : CaptureAvailableDelayPolicy {
+    override fun decide(input: CaptureAvailableDelayPolicyInput) = CaptureAvailableDelayPolicyDecision(delayMs = 0L)
+}
+
+/**
+ * The deployed policy: the larger of this capture's draft-budget deficit and the admitted-backlog deficit against
+ * the Capture Timeout. It is deadline-aware (it charges the window this capture has already spent) and
+ * workload-aware (it prices the draft sequence it is about to admit), which is exactly what the two baselines drop.
+ *
+ * The arithmetic itself stays in [computeLevelDeficitMs] and [computeBacklogDeficitMs] so offline replay keeps
+ * calling the same functions the device ran.
+ */
+object DeadlineDeficitDelayPolicy : CaptureAvailableDelayPolicy {
+
+    override fun decide(input: CaptureAvailableDelayPolicyInput): CaptureAvailableDelayPolicyDecision {
+        val levelDeficitMs = computeLevelDeficitMs(
+            draftSequenceBudgetMs = input.draftSequenceBudgetMs,
+            draftSequenceReservedDurationMs = input.draftSequenceReservedDurationMs,
+        )
+        val backlogDeficitMs = computeBacklogDeficitMs(
+            backlogMs = input.backlogMs,
+            timeToDeadlineMs = input.timeToDeadlineMs,
+            draftSequenceReservedDurationMs = input.draftSequenceReservedDurationMs,
+        )
+        return CaptureAvailableDelayPolicyDecision(
+            delayMs = maxOf(levelDeficitMs, backlogDeficitMs),
+            levelDeficitMs = levelDeficitMs,
+            backlogDeficitMs = backlogDeficitMs,
+        )
+    }
+}
