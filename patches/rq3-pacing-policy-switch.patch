diff --git a/ThermalHeadroomLutDelayPolicy.kt b/ThermalHeadroomLutDelayPolicy.kt
new file mode 100644
index 0000000..8c882a6
--- /dev/null
+++ b/ThermalHeadroomLutDelayPolicy.kt
@@ -0,0 +1,122 @@
+package com.samsung.android.camera.core2.ml
+
+import kotlin.math.roundToLong
+
+/**
+ * Open-loop thermal pacing baseline: delay is a function of thermal state and of nothing else.
+ *
+ * This is the pacing form of the guidance Android publishes for sustained workloads under the Adaptive Performance
+ * Framework - poll `getThermalHeadroom()`, and shed or space work before the device is actually throttled, with
+ * documented action thresholds at 0.85 (watch), 0.95 (reduce), and 1.0 (reduce immediately). Headroom is used rather
+ * than the ordinal overheat level for two reasons: it is continuous, so the baseline does not inherit the step
+ * discontinuity that the production guard is criticised for, and it moves within a burst rather than only between
+ * bursts. That makes this the strong form of "just react to the thermal signal", not the weak one.
+ *
+ * What it deliberately cannot see: how deep the draft queue is, how much of this capture's deadline has already been
+ * spent waiting, and how large the draft sequence it is about to admit is. Two captures at identical headroom are
+ * paced identically whether the pipeline is idle or eight drafts deep.
+ *
+ * The policy holds no state, so a burst boundary means nothing to it.
+ *
+ * @param thermalHeadroomSupplier latest valid headroom in `[0, 1]` (0 no throttling, 1 severe), or a negative value
+ *   until the device has reported one. Sampled, not polled: the platform rate-limits headroom and answers NaN when
+ *   asked faster than roughly once every ten seconds, and this runs on the captureAvailable callback.
+ */
+class ThermalHeadroomLutDelayPolicy(
+    private val thermalHeadroomSupplier: () -> Double,
+    private val config: Config = Config(),
+) : CaptureAvailableDelayPolicy {
+
+    override fun decide(input: CaptureAvailableDelayPolicyInput): CaptureAvailableDelayPolicyDecision {
+        // The one queue fact this policy reads, and it reads only the bit: is anything waiting at all. The deployed
+        // policy never delays an empty pipeline, so a baseline that charged an isolated shot a thermal delay would
+        // be paying a cost that buys nothing and losing the comparison on that alone. How much is waiting stays
+        // invisible here - that is the axis the baseline is meant to be missing.
+        if (input.queuedDraftCount <= 0) {
+            return CaptureAvailableDelayPolicyDecision(delayMs = 0L)
+        }
+        val delayMs = config.delayMs(thermalHeadroomSupplier())
+        return CaptureAvailableDelayPolicyDecision(delayMs = delayMs, levelDeficitMs = delayMs)
+    }
+
+    /**
+     * Piecewise-linear map from thermal headroom to per-transition delay.
+     *
+     * The shipped values are calibrated for the S26 Ultra at 12MP normal, starting overheat level 3, by
+     * `data/lut_calibration.py`. Recalibrate for any other device or capture configuration - the breakpoints carry
+     * over, the magnitudes do not:
+     *
+     *  1. Run the burst protocol under [CaptureAvailableDelayPolicyFactory.PolicyType.NO_PACING] and record the
+     *     headroom range the run actually visits. Points outside that range never fire and are decoration; if the
+     *     range never reaches the first non-zero point, move the knees down rather than reporting an arm that
+     *     never paced.
+     *  2. Run it under the policy being compared against and take that arm's total applied delay per burst.
+     *  3. Scale these points so this policy spends the same total over the same burst. A LUT that spends materially
+     *     less total delay cannot be reported as a losing baseline - it was simply paced less.
+     *
+     * @param delayMsByThermalHeadroom control points; headroom outside the outermost points clamps to them.
+     * @param fallbackDelayMs applied when the device reports no headroom, which degenerates this policy to
+     *   fixed-rate pacing. Kept explicit so a run on such a device is recognisable rather than silently unpaced.
+     */
+    data class Config(
+        val delayMsByThermalHeadroom: Map<Double, Long> = DEFAULT_CONTROL_POINTS,
+        val fallbackDelayMs: Long = DEFAULT_FALLBACK_DELAY_MS,
+    ) {
+        private val controlPoints = delayMsByThermalHeadroom.entries.sortedBy { entry -> entry.key }
+
+        init {
+            require(delayMsByThermalHeadroom.isNotEmpty()) { "at least one control point is required" }
+            require(delayMsByThermalHeadroom.keys.all { headroom -> headroom.isFinite() }) {
+                "control point headrooms must be finite"
+            }
+            require(delayMsByThermalHeadroom.values.all { delayMs -> delayMs >= 0L }) {
+                "control point delays must be non-negative"
+            }
+            require(fallbackDelayMs >= 0L) { "fallbackDelayMs must be non-negative" }
+        }
+
+        fun delayMs(thermalHeadroom: Double): Long {
+            if (!thermalHeadroom.isFinite() || thermalHeadroom < 0.0) {
+                return fallbackDelayMs
+            }
+
+            val upperIndex = controlPoints.indexOfFirst { point -> point.key >= thermalHeadroom }
+            if (upperIndex < 0) {
+                return controlPoints.last().value
+            }
+            if (upperIndex == 0) {
+                return controlPoints.first().value
+            }
+
+            val lower = controlPoints[upperIndex - 1]
+            val upper = controlPoints[upperIndex]
+            val ratio = (thermalHeadroom - lower.key) / (upper.key - lower.key)
+            return (lower.value + (upper.value - lower.value) * ratio).roundToLong().coerceAtLeast(0L)
+        }
+
+        private companion object {
+            /**
+             * Breakpoints are Android's own published action thresholds - 0.85 watch, 0.95 reduce, 1.0 reduce
+             * immediately - plus one earlier knee, because spacing captures is a cheaper reaction than dropping
+             * work and can therefore start before the platform asks for a reduction. A LUT that only acts from 0.85
+             * up will never fire on a burst that stays cool and would then be an unpaced arm under another name.
+             *
+             * Magnitudes are the cost-matched calibration: replayed over the nine collected No-pacing bursts, these
+             * values spend a run-median 4582 ms per 30-shot burst, equal to the reference arm's 4582 ms, so neither
+             * arm can win the comparison by simply pacing less. The observed headroom band on those runs is
+             * 0.876-0.947, over which these points vary the delay from 118 ms to 201 ms - narrow, because the
+             * thermal signal itself is narrow at a fixed starting level, which is part of what the baseline shows.
+             */
+            private val DEFAULT_CONTROL_POINTS = mapOf(
+                0.00 to 0L,
+                0.70 to 0L,
+                0.85 to 88L,
+                0.95 to 205L,
+                1.00 to 409L,
+            )
+
+            /** The calibrated delay at the median headroom observed, so an unreadable sample costs the usual amount. */
+            private const val DEFAULT_FALLBACK_DELAY_MS = 164L
+        }
+    }
+}
