new file mode 100644
index 0000000..1d98bb4
--- /dev/null
+++ b/CaptureAvailableDelayPolicyFactory.kt
@@ -0,0 +1,50 @@
+package com.samsung.android.camera.core2.ml
+
+/**
+ * The pacing-policy switch. Changing [ACTIVE_POLICY] is the whole experiment protocol: every arm then runs the same
+ * admission path, the same predictor, the same captureAvailable callback, and the same metrics writer, differing
+ * only in the delay arithmetic.
+ *
+ * The selected policy is logged when the draft pipeline is built and exported on every RQ3 row, so a collected
+ * workbook says which arm produced it rather than relying on the file name. Clear the metrics database between arms.
+ */
+object CaptureAvailableDelayPolicyFactory {
+
+    /** Change this one value to switch arms. Keep it at [PolicyType.OURS] for production-reference builds. */
+    private val ACTIVE_POLICY = PolicyType.OURS
+
+    @JvmStatic
+    fun create(deviceStateReader: DeviceStateReader): CaptureAvailableDelayPolicy = when (ACTIVE_POLICY) {
+        PolicyType.NO_PACING -> NoPacingDelayPolicy
+        PolicyType.OURS -> DeadlineDeficitDelayPolicy
+        PolicyType.THERMAL_LUT -> ThermalHeadroomLutDelayPolicy(
+            thermalHeadroomSupplier = { deviceStateReader.latestThermalHeadroom.toDouble() },
+        )
+        PolicyType.CODEL -> ControlledDelayPacingPolicy()
+    }
+
+    @JvmStatic
+    fun activePolicyName(): String = ACTIVE_POLICY.name
+
+    /**
+     * The arms, ordered from no control to full control.
+     *
+     * [THERMAL_LUT] and [CODEL] are the two baselines: one open-loop on the thermal signal alone, one closed-loop on
+     * the measured queue wait alone. Between them they cover the two things [OURS] adds - deadline awareness and a
+     * model of the draft work being admitted - so a result that separates OURS from both says which of those the
+     * separation came from.
+     */
+    enum class PolicyType {
+        /** No delay ever; the unpaced parallel-capture pipeline. */
+        NO_PACING,
+
+        /** [DeadlineDeficitDelayPolicy] - the deployed budget/backlog deficit policy. */
+        OURS,
+
+        /** [ThermalHeadroomLutDelayPolicy] - open-loop on thermal headroom; queue- and deadline-blind. */
+        THERMAL_LUT,
+
+        /** [ControlledDelayPacingPolicy] - CoDel on measured queue wait; workload- and deadline-blind. */
+        CODEL,
+    }
+}
