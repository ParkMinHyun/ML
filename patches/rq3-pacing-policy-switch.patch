diff --git a/ControlledDelayPacingPolicy.kt b/ControlledDelayPacingPolicy.kt
new file mode 100644
index 0000000..5730705
--- /dev/null
+++ b/ControlledDelayPacingPolicy.kt
@@ -0,0 +1,196 @@
+package com.samsung.android.camera.core2.ml
+
+import com.samsung.android.camera.core2.maker.MakerFeature
+import kotlin.math.ceil
+import kotlin.math.sqrt
+
+/**
+ * Closed-loop queue-feedback pacing baseline: the CoDel controlled-delay algorithm (RFC 8289; Nichols and Jacobson,
+ * "Controlling Queue Delay", ACM Queue 10(5), 2012) applied to the single-worker draft queue.
+ *
+ * CoDel controls how long work waits rather than how much work is waiting, and acts only once that wait has stayed
+ * above a target for a full interval - which is what makes it absorb bursts instead of draining the queue. Three
+ * properties carry over unchanged: the controlled quantity is the measured queue wait, the controller holds no model
+ * of the work it paces, and the action rate ramps as `interval / sqrt(count)` rather than engaging all at once.
+ * [decide] and [onDraftStarted] follow the RFC's `dequeue` and `dodequeue` routines statement for statement.
+ *
+ * Three adaptations, each forced by the pipeline rather than chosen:
+ *
+ *  1. **The action.** CoDel sheds standing queue by dropping a packet. A draft cannot be dropped - every capture must
+ *     produce an image - so the equivalent action shifts the next capture later instead, and one action is sized at
+ *     one draft's measured service time, the analogue of one packet.
+ *  2. **Where the routines run.** The RFC runs both routines at dequeue. Here the queue wait first becomes
+ *     observable when a draft starts, while the only actuator is the captureAvailable callback, so `dodequeue` runs
+ *     at draft start and the `dequeue` state machine runs at the callback.
+ *  3. **One action per callback.** The RFC's drop loop can shed several packets in one dequeue when it has fallen
+ *     behind schedule. A callback can only carry one delay, so the loop becomes a single conditional; a controller
+ *     that is behind schedule catches up on the following callbacks.
+ *
+ * What it deliberately cannot see: this capture's deadline and how much of it is already spent, and the size of the
+ * draft sequence about to be admitted. It knows only how long the last draft waited.
+ *
+ * **This policy does not collapse the queue.** It is inert while the measured wait is under target, and one action
+ * removes at most one draft's worth of work, so the queue settles near `target / serviceTime` drafts rather than at
+ * zero. Replayed over the nine collected S26 Ultra No-pacing bursts at starting level 3, that is 8 drafts at the
+ * unpaced median draft wall of 422 ms and 5 at the 726 ms wall the reference arm's heavier admitted workload
+ * produces; it stays inert on 24% of shots, and the queue is already 4 deep when it first acts, at a median of shot
+ * 9 of 30. Driving the queue empty would take a near-zero target, which is neither what RFC 8289 does nor what is
+ * configured here.
+ *
+ * Service-time learning is pipeline-lifetime, matching how the deployed policy's learned overhead outlives a burst.
+ * [clearSession] resets only the burst-local control state.
+ */
+class ControlledDelayPacingPolicy(
+    private val config: Config = Config(),
+) : CaptureAvailableDelayPolicy {
+
+    /** EWMA of measured draft wall times, which sizes one action; non-positive until the first draft completes. */
+    private var serviceTimeMs = 0.0
+
+    /** Queue wait of the draft that started most recently - the controlled quantity. */
+    private var latestQueueWaitMs = 0L
+
+    /** RFC 8289 `first_above_time_`: when the current above-target excursion becomes actionable; 0 while under. */
+    private var firstAboveTimeUptimeMs = 0L
+
+    /** RFC 8289 `ok_to_drop`, produced by [onDraftStarted] and consumed by the next [decide]. */
+    private var okToAct = false
+
+    /** RFC 8289 `dropping_`. */
+    private var acting = false
+
+    /** RFC 8289 `drop_next_`. */
+    private var nextActionUptimeMs = 0L
+
+    /** RFC 8289 `count_` and `lastcount_`. */
+    private var count = 0
+    private var lastCount = 0
+
+    /**
+     * RFC 8289 `dequeue`: the two-state control loop, run here at the callback because that is where the actuator
+     * is. Leaves the control state consistent even when the action it decides on is zero-length.
+     */
+    override fun decide(input: CaptureAvailableDelayPolicyInput): CaptureAvailableDelayPolicyDecision {
+        val nowUptimeMs = input.decisionUptimeMs
+        var delayMs = 0L
+
+        if (acting) {
+            if (!okToAct) {
+                acting = false
+            } else if (nowUptimeMs >= nextActionUptimeMs) {
+                delayMs = actionDelayMs()
+                count += 1
+                nextActionUptimeMs = controlLaw(nextActionUptimeMs, count)
+            }
+        } else if (okToAct) {
+            delayMs = actionDelayMs()
+            acting = true
+            // RFC 8289 resumes rather than restarts the ramp when an excursion returns soon after the last one, so
+            // a queue that keeps crossing the target is not repeatedly paced from the slowest action rate.
+            val delta = count - lastCount
+            count = if (delta > 1 && nowUptimeMs - nextActionUptimeMs < config.intervalMs * REENTRY_INTERVALS) {
+                delta
+            } else {
+                1
+            }
+            nextActionUptimeMs = controlLaw(nowUptimeMs, count)
+            lastCount = count
+        }
+
+        return CaptureAvailableDelayPolicyDecision(delayMs = delayMs, backlogDeficitMs = delayMs)
+    }
+
+    /**
+     * RFC 8289 `dodequeue`: measures this draft's queue wait and decides whether the excursion above target has
+     * lasted a full interval. [queuedDraftCount] is the depth left behind this draft, so zero is the RFC's
+     * `bytes() <= maxpacket_` case - a queue that cannot be shortened without emptying it is not acted on.
+     *
+     * The wait excludes the delay that gated the draft. Charging a policy's own delay back to it as queue wait would
+     * close a positive feedback loop in which pacing manufactures the evidence that more pacing is needed.
+     */
+    override fun onDraftStarted(
+        startUptimeMs: Long,
+        gatingDecision: CaptureAvailablePacingDecision?,
+        queuedDraftCount: Int,
+    ) {
+        latestQueueWaitMs = gatingDecision
+            ?.let { decision -> startUptimeMs - (decision.decisionUptimeMs + decision.delayMs) }
+            ?.coerceAtLeast(0L)
+            ?: 0L
+
+        okToAct = false
+        if (latestQueueWaitMs < config.targetMs || queuedDraftCount <= 0) {
+            firstAboveTimeUptimeMs = 0L
+        } else if (firstAboveTimeUptimeMs == 0L) {
+            firstAboveTimeUptimeMs = startUptimeMs + config.intervalMs
+        } else if (startUptimeMs >= firstAboveTimeUptimeMs) {
+            okToAct = true
+        }
+    }
+
+    override fun onDraftMeasured(sizeBucket: SizeBucket, draftSequenceDurationMs: Long) {
+        if (draftSequenceDurationMs <= 0L) {
+            return
+        }
+        serviceTimeMs = if (serviceTimeMs <= 0.0) {
+            draftSequenceDurationMs.toDouble()
+        } else {
+            serviceTimeMs * (1.0 - config.serviceTimeAlpha) + draftSequenceDurationMs * config.serviceTimeAlpha
+        }
+    }
+
+    override fun clearSession() {
+        latestQueueWaitMs = 0L
+        firstAboveTimeUptimeMs = 0L
+        okToAct = false
+        acting = false
+        nextActionUptimeMs = 0L
+        count = 0
+        lastCount = 0
+    }
+
+    /** One packet's worth of standing queue: the excess wait above target, capped at one draft's service time. */
+    private fun actionDelayMs(): Long =
+        minOf(latestQueueWaitMs - config.targetMs, ceil(serviceTimeMs).toLong()).coerceAtLeast(0L)
+
+    /** RFC 8289 `control_law`. */
+    private fun controlLaw(fromUptimeMs: Long, actionCount: Int): Long =
+        fromUptimeMs + ceil(config.intervalMs / sqrt(actionCount.toDouble())).toLong()
+
+    /**
+     * @param targetMs standing queue wait tolerated before pacing engages. RFC 8289's 5 ms does not transfer: there
+     *   the queue is pure overhead and the target is set from the TCP round trip, whereas here the queue is the
+     *   parallel-capture feature itself. The target is therefore stated against the Capture Timeout budget - at most
+     *   half of a capture's deadline may be consumed by waiting. Halving it roughly halves the queue depth the
+     *   controller settles at.
+     * @param intervalMs how long the wait must stay above target before acting, and the base of the action-rate
+     *   ramp. This is the RFC's INTERVAL, which is one round trip - the lag before an action reaches the queue. Here
+     *   that is one shot-to-shot period, since a delay applied at this callback first affects the queue when the
+     *   next capture's draft is enqueued.
+     * @param serviceTimeAlpha EWMA weight for measured draft wall times.
+     */
+    data class Config(
+        val targetMs: Long = (MakerFeature.CAPTURE_TIMEOUT_MS * TARGET_DEADLINE_FRACTION).toLong(),
+        val intervalMs: Long = DEFAULT_INTERVAL_MS,
+        val serviceTimeAlpha: Double = DEFAULT_SERVICE_TIME_ALPHA,
+    ) {
+        init {
+            require(targetMs >= 0L) { "targetMs must be non-negative but was $targetMs" }
+            require(intervalMs > 0L) { "intervalMs must be positive but was $intervalMs" }
+            require(serviceTimeAlpha > 0.0 && serviceTimeAlpha <= 1.0) {
+                "serviceTimeAlpha must be in (0, 1] but was $serviceTimeAlpha"
+            }
+        }
+
+        private companion object {
+            private const val TARGET_DEADLINE_FRACTION = 0.5
+            private const val DEFAULT_INTERVAL_MS = 500L
+            private const val DEFAULT_SERVICE_TIME_ALPHA = 0.25
+        }
+    }
+
+    private companion object {
+        /** RFC 8289's 16-interval window for treating a new excursion as a continuation of the previous one. */
+        private const val REENTRY_INTERVALS = 16L
+    }
+}
