new file mode 100644
index 0000000000000000000000000000000000000000..2d3d7e67ac752df998049cb937d18ef8fce60c8a
--- /dev/null
+++ b/QueueEwmaCaptureAvailableDelayPolicy.kt
@@ -0,0 +1,87 @@
+package com.samsung.android.camera.core2.ml
+
+import kotlin.math.ceil
+
+/**
+ * RQ3 queue-feedback baseline.
+ *
+ * The policy estimates the unfinished single-worker occupancy from only observable queue state and an EWMA of Drafts
+ * that completed before the decision.  It does not read the pacer's per-workload predictions or its predicted backlog
+ * clock.  The active Draft is charged only its estimated remaining wall time; not-yet-started Drafts are each charged
+ * one full EWMA service time.  Its target is fixed for the calibrated configuration, so thermal bucket changes
+ * cannot abruptly alter the feedback response.
+ *
+ * The EWMA is pipeline-lifetime learned state, matching Ours' learned overhead lifetime.  [clearSession] removes only
+ * burst-local occupancy so repeated 30-shot trials can choose explicitly between a new policy instance (cold) and a
+ * retained instance (warm).
+ */
+class QueueEwmaCaptureAvailableDelayPolicy(
+    private val config: Config,
+) : CaptureAvailableDelayPolicy {
+
+    private val serviceTimeMsBySize = config.initialServiceTimeMsBySize.toMutableMap()
+    private var activeDraftStartUptimeMs: Long? = null
+    private var activeSizeBucket: SizeBucket? = null
+
+    override fun decide(input: CaptureAvailableDelayPolicyInput): CaptureAvailableDelayPolicyDecision {
+        val serviceTimeMs = serviceTimeMs(activeSizeBucket)
+        val activeRemainingMs = activeDraftStartUptimeMs?.let { startUptimeMs ->
+            (serviceTimeMs - (input.decisionUptimeMs - startUptimeMs).coerceAtLeast(0L)).coerceAtLeast(0.0)
+        } ?: 0.0
+        val queuedWorkMs = input.queuedDraftCount.coerceAtLeast(0).toDouble() * serviceTimeMs
+        val estimatedBacklogMs = ceil(activeRemainingMs + queuedWorkMs).toLong()
+        val backlogDeficitMs = (estimatedBacklogMs - config.targetBacklogMs).coerceAtLeast(0L)
+
+        return CaptureAvailableDelayPolicyDecision(
+            delayMs = backlogDeficitMs,
+            levelDeficitMs = 0L,
+            backlogDeficitMs = backlogDeficitMs,
+            backlogMs = estimatedBacklogMs,
+        )
+    }
+
+    override fun onDraftStarted(sizeBucket: SizeBucket?, startUptimeMs: Long) {
+        activeDraftStartUptimeMs = startUptimeMs
+        activeSizeBucket = sizeBucket
+    }
+
+    override fun onDraftMeasured(sizeBucket: SizeBucket, draftWallMs: Long) {
+        activeDraftStartUptimeMs = null
+        activeSizeBucket = null
+        if (draftWallMs <= 0L) {
+            return
+        }
+
+        val previousEstimateMs = serviceTimeMs(sizeBucket)
+        serviceTimeMsBySize[sizeBucket] =
+            previousEstimateMs * (1.0 - config.alpha) + draftWallMs.toDouble() * config.alpha
+    }
+
+    override fun clearSession() {
+        activeDraftStartUptimeMs = null
+        activeSizeBucket = null
+    }
+
+    /** Explicit cold reset for a test harness; normal burst drain intentionally keeps learned service times. */
+    fun resetLearnedServiceTimes() {
+        serviceTimeMsBySize.clear()
+        serviceTimeMsBySize.putAll(config.initialServiceTimeMsBySize)
+    }
+
+    private fun serviceTimeMs(sizeBucket: SizeBucket?): Double =
+        sizeBucket?.let { serviceTimeMsBySize[it] } ?: config.fallbackInitialServiceTimeMs
+
+    data class Config(
+        val alpha: Double,
+        val initialServiceTimeMsBySize: Map<SizeBucket, Double>,
+        val fallbackInitialServiceTimeMs: Double,
+        val targetBacklogMs: Long,
+    ) {
+        init {
+            require(alpha > 0.0 && alpha <= 1.0)
+            require(initialServiceTimeMsBySize.values.all { serviceTimeMs -> serviceTimeMs > 0.0 })
+            require(fallbackInitialServiceTimeMs > 0.0)
+            require(targetBacklogMs >= 0L)
+        }
+    }
+}
