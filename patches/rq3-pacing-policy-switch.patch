diff --git a/CaptureAvailableDelayPolicy.kt b/CaptureAvailableDelayPolicy.kt
new file mode 100644
index 0000000000000000000000000000000000000000..6658da33f6f051db0e6a195a94593c9c3f9e751c
--- /dev/null
+++ b/CaptureAvailableDelayPolicy.kt
@@ -0,0 +1,74 @@
+package com.samsung.android.camera.core2.ml
+
+/**
+ * Delay arithmetic selected by [CaptureAvailablePacer].
+ *
+ * The pacer continues to own admission pairing, workload prediction, session boundaries, and metrics.  A policy sees
+ * one immutable decision snapshot and returns only the delay components it actually used.  This keeps RQ3 policies
+ * interchangeable without giving a baseline a different admission path or a different captureAvailable callback.
+ *
+ * Not synchronized: [CaptureAvailablePacer] invokes every method under its own lock.
+ */
+interface CaptureAvailableDelayPolicy {
+    fun decide(input: CaptureAvailableDelayPolicyInput): CaptureAvailableDelayPolicyDecision
+
+    /** A Draft entered the single-worker pipeline. */
+    fun onDraftStarted(sizeBucket: SizeBucket?, startUptimeMs: Long) = Unit
+
+    /** A Draft left the single-worker pipeline with an observable wall time. */
+    fun onDraftMeasured(sizeBucket: SizeBucket, draftWallMs: Long) = Unit
+
+    /** Clears burst-local state.  Pipeline-lifetime calibration may deliberately remain. */
+    fun clearSession() = Unit
+}
+
+/** Runtime facts available at one captureAvailable decision. */
+data class CaptureAvailableDelayPolicyInput(
+    val decisionUptimeMs: Long,
+    val draftSequenceBudgetMs: Long,
+    val draftSequencePacingDurationMs: Double,
+    val predictedBacklogMs: Long,
+    val queuedDraftCount: Int,
+    val shutterElapsedMs: Long,
+)
+
+/**
+ * Policy result projected into the existing pacing metrics.
+ *
+ * [backlogMs] is the backlog estimate used by this policy.  It is therefore the predicted-work clock for Ours, zero
+ * for Thermal LUT, and the queue/EWMA estimate for Queue-EWMA.
+ */
+data class CaptureAvailableDelayPolicyDecision(
+    val delayMs: Long,
+    val levelDeficitMs: Long,
+    val backlogDeficitMs: Long,
+    val backlogMs: Long,
+) {
+    init {
+        require(delayMs >= 0L)
+        require(levelDeficitMs >= 0L)
+        require(backlogDeficitMs >= 0L)
+        require(backlogMs >= 0L)
+    }
+}
+
+/** Existing context-aware budget/backlog arithmetic, extracted as the default swappable policy. */
+object ContextAwareCaptureAvailableDelayPolicy : CaptureAvailableDelayPolicy {
+    override fun decide(input: CaptureAvailableDelayPolicyInput): CaptureAvailableDelayPolicyDecision {
+        val levelDeficitMs = computeCaptureAvailableLevelDeficitMs(
+            draftSequenceBudgetMs = input.draftSequenceBudgetMs,
+            draftSequencePacingDurationMs = input.draftSequencePacingDurationMs,
+        )
+        val backlogDeficitMs = computeCaptureAvailableBacklogDeficitMs(
+            backlogMs = input.predictedBacklogMs,
+            shutterElapsedMs = input.shutterElapsedMs,
+            draftSequencePacingDurationMs = input.draftSequencePacingDurationMs,
+        )
+        return CaptureAvailableDelayPolicyDecision(
+            delayMs = maxOf(levelDeficitMs, backlogDeficitMs),
+            levelDeficitMs = levelDeficitMs,
+            backlogDeficitMs = backlogDeficitMs,
+            backlogMs = input.predictedBacklogMs,
+        )
+    }
+}
diff --git a/CaptureAvailableDelayPolicyFactory.kt b/CaptureAvailableDelayPolicyFactory.kt
new file mode 100644
index 0000000000000000000000000000000000000000..37142753eb041a60c07a8b3de780e73f2888e68e
--- /dev/null
+++ b/CaptureAvailableDelayPolicyFactory.kt
@@ -0,0 +1,66 @@
+package com.samsung.android.camera.core2.ml
+
+import android.os.Build
+import java.util.function.DoubleSupplier
+
+/**
+ * One experiment switch for RQ3 pacing-policy runs.
+ *
+ * Keep [activePolicy] at OURS for production-reference builds.  To collect a baseline, add the exact Build.MODEL
+ * configuration to the corresponding map and change only [activePolicy].  A missing device calibration fails at
+ * construction instead of silently running an uncalibrated zero-delay baseline.
+ */
+object CaptureAvailableDelayPolicyFactory {
+    private val activePolicy = PolicyType.OURS
+
+    /*
+     * Populate from calibration sessions only.  Each map key is the exact Build.MODEL string exported as deviceModel.
+     * Do not reuse one device's LUT or EWMA parameters for another device merely to make an evaluation build run.
+     */
+    private val thermalLutConfigByDevice:
+        Map<String, ThermalLutCaptureAvailableDelayPolicy.Config> = emptyMap()
+    private val queueEwmaConfigByDevice:
+        Map<String, QueueEwmaCaptureAvailableDelayPolicy.Config> = emptyMap()
+
+    @JvmStatic
+    fun create(deviceStateReader: DeviceStateReader): CaptureAvailableDelayPolicy {
+        val deviceModel = Build.MODEL
+        return when (activePolicy) {
+            PolicyType.OURS -> ContextAwareCaptureAvailableDelayPolicy
+            PolicyType.THERMAL_LUT -> ThermalLutCaptureAvailableDelayPolicy(
+                config = requireDeviceConfig(
+                    policyName = PolicyType.THERMAL_LUT.name,
+                    deviceModel = deviceModel,
+                    configByDevice = thermalLutConfigByDevice,
+                ),
+                thermalHeadroomSupplier = DoubleSupplier {
+                    deviceStateReader.readLatestThermalHeadroom().toDouble()
+                },
+            )
+            PolicyType.QUEUE_EWMA -> QueueEwmaCaptureAvailableDelayPolicy(
+                config = requireDeviceConfig(
+                    policyName = PolicyType.QUEUE_EWMA.name,
+                    deviceModel = deviceModel,
+                    configByDevice = queueEwmaConfigByDevice,
+                ),
+            )
+        }
+    }
+
+    @JvmStatic
+    fun activePolicyName(): String = activePolicy.name
+
+    private fun <T> requireDeviceConfig(
+        policyName: String,
+        deviceModel: String,
+        configByDevice: Map<String, T>,
+    ): T = requireNotNull(configByDevice[deviceModel]) {
+        "$policyName has no calibrated configuration for Build.MODEL=$deviceModel"
+    }
+
+    enum class PolicyType {
+        OURS,
+        THERMAL_LUT,
+        QUEUE_EWMA,
+    }
+}
