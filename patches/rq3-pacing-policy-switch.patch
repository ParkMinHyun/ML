new file mode 100644
index 0000000..7dbffc1
--- /dev/null
+++ b/data/lut_calibration.py
@@ -0,0 +1,86 @@
+"""Calibrate ThermalHeadroomLutDelayPolicy magnitudes against the collected S26 Ultra runs.
+
+Cost-matching: scale the LUT so its burst-total applied delay equals the reference
+arm's, so the baseline cannot be reported as losing on cost it never spent.
+
+Open-loop by construction: the LUT is replayed over the No-pacing headroom and
+queue-depth trajectory. Under real pacing both would shift. This sets the
+magnitude; it does not predict the paced trajectory.
+"""
+import numpy as np
+import pandas as pd
+
+SEIP = r"C:\Users\sal_eunki\Desktop\SEIP-27\data"
+ML = r"C:\Users\sal_eunki\Desktop\ML\data"
+
+NO_PACING = [rf"{SEIP}\48U_metrics_12MP_normal_0729_AdmitOnly_1.xlsx",
+             rf"{SEIP}\48U_metrics_12MP_normal_0729_AdmitOnly_2.xlsx"]
+OURS = [rf"{ML}\48U_metrics_12MP_normal_0729.xlsx"]
+
+START_LEVEL, WINDOW = 3, 30
+
+# Shape only; step 3 scales the magnitudes. Breakpoints are Android's published
+# ADPF action thresholds plus one earlier knee.
+SHAPE = [(0.00, 0.0), (0.70, 0.0), (0.85, 150.0), (0.95, 350.0), (1.00, 700.0)]
+
+
+def runs(files):
+    """Per-workbook run keys, so runId 1 in two workbooks stays two runs."""
+    out = []
+    for fi, path in enumerate(files):
+        df = pd.ExcelFile(path).parse("RQ3Pacing")
+        df = df[(df.startingOverheatLevel == START_LEVEL) &
+                (df.runShotCount >= WINDOW) & (df.runShotIndex <= WINDOW)].copy()
+        df["runKey"] = f"w{fi}_" + df.runId.astype(str)
+        out.append(df)
+    return pd.concat(out, ignore_index=True)
+
+
+def lut(headroom, scale):
+    xs = [p[0] for p in SHAPE]
+    ys = [p[1] * scale for p in SHAPE]
+    if not np.isfinite(headroom) or headroom < 0:
+        return ys[2]                      # fallback = the 0.85 point
+    return float(np.interp(headroom, xs, ys))
+
+
+def run_total(df, scale):
+    """Burst-total delay: transitions only, gated on a non-empty draft queue."""
+    d = df[df.transitionDelayMs.notna()]
+    h = pd.to_numeric(d.shotThermalHeadroom, errors="coerce")
+    q = pd.to_numeric(d.controllerQueuedDraftCount, errors="coerce").fillna(0)
+    return sum(lut(hi, scale) for hi, qi in zip(h, q) if qi > 0)
+
+
+npac, ours = runs(NO_PACING), runs(OURS)
+
+target = ours[ours.transitionDelayMs.notna()].groupby("runKey").transitionDelayMs.sum().median()
+print(f"reference (Ours) run-median total delay : {target:.0f} ms")
+
+base = npac.groupby("runKey").apply(lambda d: run_total(d, 1.0), include_groups=False)
+print(f"unscaled LUT run-median total delay     : {base.median():.0f} ms"
+      f"   (range {base.min():.0f}-{base.max():.0f})")
+
+scale = target / base.median()
+print(f"\nscale = {scale:.4f}")
+
+got = npac.groupby("runKey").apply(lambda d: run_total(d, scale), include_groups=False)
+print(f"calibrated LUT run-median total delay   : {got.median():.0f} ms"
+      f"   (range {got.min():.0f}-{got.max():.0f})")
+
+h = pd.to_numeric(npac.shotThermalHeadroom, errors="coerce").dropna()
+
+print("\nDEFAULT_CONTROL_POINTS for ThermalHeadroomLutDelayPolicy.Config:")
+for x, y in SHAPE:
+    print(f"    {x:.2f} to {round(y * scale):d}L,")
+print(f"DEFAULT_FALLBACK_DELAY_MS = {round(lut(h.median(), scale))}L"
+      f"   (the calibrated delay at the median observed headroom)")
+
+print(f"\nheadroom band actually visited: p05={h.quantile(.05):.3f} "
+      f"p50={h.median():.3f} p95={h.quantile(.95):.3f} "
+      f"(min={h.min():.3f} max={h.max():.3f})")
+print(f"  delay at p05/p50/p95 headroom: "
+      f"{lut(h.quantile(.05), scale):.0f} / {lut(h.median(), scale):.0f} / "
+      f"{lut(h.quantile(.95), scale):.0f} ms")
+gate = pd.to_numeric(npac.controllerQueuedDraftCount, errors="coerce").fillna(0)
+print(f"  transitions with a non-empty queue: {(gate > 0).mean() * 100:.1f}%")
